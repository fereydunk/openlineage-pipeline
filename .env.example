# openlineage-pipeline — environment configuration
# Copy to `.env` (gitignored). `source .env` before running scripts.

# ── Confluent Cloud (reuses the shared DEVTEST env; filled by scripts/00_discover_env.sh) ──
ENV_ID=env-m2qxq
ENV_NAME=DEVTEST
CLUSTER_ID=lkc-w71g5v5
CLUSTER_NAME=cluster_0
BOOTSTRAP_SERVERS=pkc-k6yr2m.us-east-2.aws.confluent.cloud:9092
CLOUD_REGION=us-east-2
CLOUD_PROVIDER=aws

# Cluster-scoped Kafka API key (used by the Connect worker + console tools)
KAFKA_API_KEY=
KAFKA_API_SECRET=

# Schema Registry
SR_ID=lsrc-jwp0w
SR_URL=
SR_API_KEY=
SR_API_SECRET=

# Flink compute pool (us-east-2)
FLINK_COMPUTE_POOL=lfcp-6kgnyv6

# Cloud resource-management API key (org-scoped; needed for Tableflow provider integration + enable).
# Distinct from the cluster/SR keys above.
CLOUD_API_KEY=
CLOUD_API_SECRET=

# ── Topics ──
DB2_TOPIC=db2-orders
ENRICHED_TOPIC=orders-enriched

# ── Local DB2 (Docker) ──
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=TESTDB
DB2_USER=db2inst1
DB2_PASSWORD=olpipeDb2pw
DB2_TABLE=ORDERS

# Connect worker REST endpoint (self-managed, Docker)
CONNECT_REST=http://localhost:8083

# ── AWS (BYOS Tableflow: S3 + Glue). Filled by infra/01_create_aws_resources.py ──
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=586051073099
AWS_S3_BUCKET=olpipe-tableflow-586051073099
AWS_GLUE_DATABASE=olpipe
AWS_IAM_ROLE_ARN=
# Tableflow provider-integration id (filled by infra/02_setup_tableflow.py)
TABLEFLOW_PROVIDER_INTEGRATION_ID=
# Iceberg S3 prefix / table
ICEBERG_S3_PREFIX=warehouse
ICEBERG_TABLE=orders_enriched

# AWS credentials come from your environment / SSO (export AWS_ACCESS_KEY_ID etc. before running infra).
